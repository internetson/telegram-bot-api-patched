# Учётные данные Telegram Bot API.
# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# .env находится в .gitignore и в репозиторий не попадёт.

# Идентификатор приложения: https://my.telegram.org/apps
TELEGRAM_API_ID=
# Хеш приложения: https://my.telegram.org/apps
TELEGRAM_API_HASH=